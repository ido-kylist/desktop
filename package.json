{
  "name": "cleon-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Cleon Desktop \u2014 local-first AI inference app",
  "main": "out/main/index.js",
  "author": "ido-kylist",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac --arm64",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node mock/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "perf": "node scripts/perf/measure.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "better-sqlite3": "13.1.1",
    "drizzle-orm": "0.45.4",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
